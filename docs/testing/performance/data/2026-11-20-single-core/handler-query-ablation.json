  "sources": {
    "current": "def get_handlers_for_event(self, event_name: str) -> list[ApixEventHandler]:\n    \"\"\"Capture received listeners, ordinary handlers, then processed listeners.\n\n    Only the resulting reference list is copied. Its order and membership\n    survive listener cleanup and registration changes during dispatch.\n    \"\"\"\n    chain = self.get_subscription_chain_for_event(event_name)\n    if not self._waiter_cache.positions:\n        return [self.registry[name] for name in chain]\n    received, processed = self._waiter_cache.get(event_name)\n    handlers = received.copy()\n    handlers.extend((self.registry[name] for name in chain))\n    handlers.extend(processed)\n    return handlers",
    "no_cell": "def get_handlers_for_event(self, event_name: str) -> list[ApixEventHandler]:\n    \"\"\"Capture received listeners, ordinary handlers, then processed listeners.\n\n    Only the resulting reference list is copied. Its order and membership\n    survive listener cleanup and registration changes during dispatch.\n    \"\"\"\n    chain = self.get_subscription_chain_for_event(event_name)\n    if not self._waiter_cache.positions:\n        return [self.registry[name] for name in chain]\n    received, processed = self._waiter_cache.get(event_name)\n    handlers = received.copy()\n    handlers.extend([self.registry[name] for name in chain])\n    handlers.extend(processed)\n    return handlers",
    "no_check": "def get_handlers_for_event(self, event_name: str) -> list[ApixEventHandler]:\n    \"\"\"Capture received listeners, ordinary handlers, then processed listeners.\n\n    Only the resulting reference list is copied. Its order and membership\n    survive listener cleanup and registration changes during dispatch.\n    \"\"\"\n    chain = self.get_subscription_chain_for_event(event_name)\n    if True:\n        return [self.registry[name] for name in chain]\n    received, processed = self._waiter_cache.get(event_name)\n    handlers = received.copy()\n    handlers.extend((self.registry[name] for name in chain))\n    handlers.extend(processed)\n    return handlers",
    "neither": "def get_handlers_for_event(self, event_name: str) -> list[ApixEventHandler]:\n    \"\"\"Capture received listeners, ordinary handlers, then processed listeners.\n\n    Only the resulting reference list is copied. Its order and membership\n    survive listener cleanup and registration changes during dispatch.\n    \"\"\"\n    chain = self.get_subscription_chain_for_event(event_name)\n    if True:\n        return [self.registry[name] for name in chain]\n    received, processed = self._waiter_cache.get(event_name)\n    handlers = received.copy()\n    handlers.extend([self.registry[name] for name in chain])\n    handlers.extend(processed)\n    return handlers",
    "local_only": "def get_handlers_for_event(self,event_name):\n    chain = self.get_subscription_chain_for_event(event_name)\n    return [self.registry[name] for name in chain]\n",
    "inline_only": "def get_handlers_for_event(self,event_name):\n    return [self.registry[name] for name in self.get_subscription_chain_for_event(event_name)]\n"
  },
